# Dominio público del sitio (sitemap, canonical, Open Graph).
SITE_URL=https://vioguamvp.vercel.app

# URL base de las Edge Functions de Supabase.
# Con valor: el pedido se guarda, el horario queda tomado, se suben fotos y test, y VioGua gestiona
# los turnos en /estudio/. Ej.: https://aqerfgqnvpwkmcynlcjj.supabase.co/functions/v1
# Vacío: el turno se pide por WhatsApp y no se guarda nada en el sitio.
PUBLIC_API_URL=

# true cuando Google Calendar esté conectado en Supabase (secretos GOOGLE_*): el turno se confirma
# solo, con evento y link de Meet. false = el pedido va por WhatsApp y VioGua lo confirma a mano.
PUBLIC_GOOGLE_CALENDAR=false

# true cuando la plantilla de WhatsApp Cloud API esté aprobada y el envío sea automático.
# false = la pantalla ofrece "Confirmá por WhatsApp" con el mensaje ya escrito.
PUBLIC_WHATSAPP_AUTO=false
