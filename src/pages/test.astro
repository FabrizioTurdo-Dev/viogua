---
// Turno (cantidad → ambientes → reunión → confirmación) y test de estilo
// (estilos → colores → sensaciones → materiales → carga → moodboard).
import '../styles/test.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Grilla from '../components/test/Grilla.astro';
import Icono from '../components/marca/Icono.astro';
import IsotipoSvg from '../brand/isotipo.svg';
import Monograma from '../brand/monograma.svg';
import { AGENDA, CON_BACKEND, ESTUDIO, POR_WHATSAPP, precio, whatsappUrl } from '../data/estudio';
import { ESTILOS, MATERIALES } from '../data/test';
import { fotoEstilo, fotoMaterial } from '../data/fotos';
import { esquemaReunion } from '../data/esquema';

// Fotos para el collage, la animación de carga y la imagen para Instagram (mismo origen, sin CORS).
const foto = async (src: ImageMetadata) => (await getImage({ src, width: 720, format: 'webp', quality: 78 })).src;
const fotos = {
  estilos: Object.fromEntries(await Promise.all(ESTILOS.map(async e => [e.id, await foto(fotoEstilo(e.id))]))),
  materiales: Object.fromEntries(await Promise.all(MATERIALES.map(async m => [m.id, await foto(fotoMaterial(m.id))]))),
};
const datos = { fotos, sitio: Astro.site!.href };
const moodboardPorWhatsapp = whatsappUrl('¡Hola, VioGua! Hice el test de estilo y les mando mi moodboard.');
---

<Base
  titulo={`Agendá tu reunión y hacé el test de estilo · ${ESTUDIO.nombre}`}
  descripcion="Elegí tus ambientes, agendá una videollamada por Google Meet y hacé el test de estilo: 4 estilos, 4 colores, 4 sensaciones y 4 materiales. Te regalamos tu moodboard."
  datos={esquemaReunion(Astro.site!)}
  clase="pagina-test"
>
  <script type="application/json" id="datos-test" set:html={JSON.stringify(datos)} />

  <div class="test envoltura" data-test>
    <div class="test-cabeza">
      <button class="enlace" id="test-volver" type="button">← Volver</button>
      <p class="test-contador"><span id="test-contador" aria-live="polite"></span></p>
      <button class="enlace" id="test-reiniciar" type="button">Empezar de nuevo</button>
    </div>

    <h1 class="visualmente-oculto">Agendá tu reunión y hacé el test de estilo</h1>

    <ol class="tramos" id="tramos" aria-label="Progreso">
      <li data-tramo="turno"><span>Turno</span></li>
      <li data-tramo="test"><span>Test de estilo</span></li>
      <li data-tramo="resultado"><span>Moodboard</span></li>
    </ol>

    <div class="panel">
      <!-- 1. Cantidad -->
      <section class="paso-test" data-paso="cantidad">
        <p class="etiqueta">Paso 1 · Turno</p>
        <h2 tabindex="-1">¿Cuántos ambientes querés diseñar?</h2>
        <div class="cantidades" role="radiogroup" aria-label="Cantidad de ambientes">
          <label class="cantidad"><input type="radio" name="cantidad" value="1" /><span class="cantidad-num">1</span><span>ambiente</span><span class="cantidad-precio">{precio(1)}</span></label>
          <label class="cantidad"><input type="radio" name="cantidad" value="2" /><span class="cantidad-num">2</span><span>ambientes</span><span class="cantidad-precio">{precio(2)}</span></label>
          <label class="cantidad"><input type="radio" name="cantidad" value="3" /><span class="cantidad-num">3</span><span>ambientes</span><span class="cantidad-precio">{precio(3)}</span></label>
          <label class="cantidad cantidad--promo"><input type="radio" name="cantidad" value="4" /><span class="cantidad-num">4<small>+1</small></span><span>ambientes y uno de regalo</span><span class="cantidad-precio">{precio(4)}</span></label>
        </div>
        <div class="desglose">
          <dl class="desglose-lista" id="desglose" aria-label="Detalle del precio" hidden></dl>
          <p class="nota">Render y búsqueda de presupuesto se cobran por ambiente; el acompañamiento del proceso, una sola vez.</p>
        </div>
        <div class="paso-pie">
          <span class="error" id="error-cantidad" role="alert"></span>
          <button class="boton" type="button" id="cantidad-siguiente">Siguiente</button>
        </div>
      </section>

      <!-- 2. Ambientes -->
      <section class="paso-test" data-paso="ambientes" hidden>
        <p class="etiqueta">Paso 2 · Turno</p>
        <h2 tabindex="-1">¿Qué ambientes son?</h2>
        <p class="bajada">
          {CON_BACKEND
            ? 'Escribí el nombre de cada uno. Las fotos son opcionales, pero nos ayudan a llegar a la reunión con ideas.'
            : 'Escribí el nombre de cada uno. Si querés, después nos mandás fotos por WhatsApp: nos ayudan a llegar a la reunión con ideas.'}
        </p>
        <div class="ambientes" id="lista-ambientes"></div>
        <template id="plantilla-ambiente">
          <div class="ambiente">
            <div class="ambiente-cabeza"><label></label></div>
            <input class="campo" type="text" autocomplete="off" maxlength="60" placeholder="Living, dormitorio principal…" />
            <div class="chips"></div>
            {
              CON_BACKEND && (
                <div class="foto">
                  <input type="file" accept="image/*" />
                  <label class="foto-boton"><Icono nombre="camara" /><span>Agregar foto</span></label>
                  <span class="foto-ayuda">opcional · podés arrastrarla acá</span>
                  <img class="foto-vista" alt="" hidden />
                  <button class="enlace foto-quitar" type="button" hidden>Quitar</button>
                </div>
              )
            }
          </div>
        </template>
        <div class="paso-pie">
          <span class="error" id="error-ambientes" role="alert"></span>
          <button class="boton" type="button" id="ambientes-siguiente">Siguiente</button>
        </div>
      </section>

      <!-- 3. Reunión -->
      <section class="paso-test" data-paso="reunion" hidden>
        <p class="etiqueta">Paso 3 · Turno</p>
        <h2 tabindex="-1">Elegí el día de la videollamada</h2>
        <form class="agenda" id="form-reunion" novalidate>
          <div class="calendario">
            <div class="calendario-cabeza">
              <button class="redondo" type="button" id="mes-anterior" aria-label="Mes anterior">‹</button>
              <p class="calendario-mes" id="calendario-mes" aria-live="polite"></p>
              <button class="redondo" type="button" id="mes-siguiente" aria-label="Mes siguiente">›</button>
            </div>
            <div class="calendario-dias" aria-hidden="true"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
            <div class="calendario-grilla" id="calendario-grilla"></div>
            <p class="nota">Reuniones de {AGENDA.duracionMin} minutos por {AGENDA.plataforma}. Horarios de Argentina.</p>
          </div>
          <div class="agenda-detalle">
            <div>
              <p class="etiqueta" id="horarios-titulo">Elegí un día</p>
              <div class="horarios" id="horarios" role="group" aria-labelledby="horarios-titulo"></div>
            </div>
            <div class="campo-grupo">
              <label for="cliente-nombre">Tu nombre</label>
              <input class="campo" id="cliente-nombre" name="nombre" type="text" autocomplete="name" maxlength="80" placeholder="Sofía Pérez" aria-describedby="error-nombre" />
              <p class="campo-error" id="error-nombre"></p>
            </div>
            <div class="campo-grupo">
              <label for="cliente-email">Tu email</label>
              <input class="campo" id="cliente-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" placeholder="sofia@gmail.com" aria-describedby="ayuda-email error-email" />
              <p class="campo-ayuda" id="ayuda-email">Te mandamos la invitación con el link de Google Meet.</p>
              <p class="campo-error" id="error-email"></p>
            </div>
            <div class="campo-grupo">
              <label for="cliente-tel">Tu WhatsApp</label>
              <input class="campo" id="cliente-tel" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" maxlength="24" placeholder="11 2345 6789" aria-describedby="ayuda-tel error-tel" />
              <p class="campo-ayuda" id="ayuda-tel">Código de área sin 0 y número sin 15.</p>
              <p class="campo-error" id="error-tel"></p>
            </div>
            <div class="trampa" aria-hidden="true">
              <label for="cliente-web">Tu sitio web</label>
              <input id="cliente-web" name="web" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <label class="consentimiento">
              <input type="checkbox" id="cliente-consentimiento" name="consentimiento" aria-describedby="error-consentimiento" />
              <span>Acepto que {ESTUDIO.nombre} use estos datos para coordinar la reunión. <a href="/privacidad/" target="_blank">Política de privacidad</a>.</span>
            </label>
            <p class="campo-error" id="error-consentimiento"></p>
          </div>
        </form>
        <div class="paso-pie">
          <span class="error" id="error-reunion" role="alert"></span>
          <button class="boton" type="submit" form="form-reunion" id="confirmar-reunion">{POR_WHATSAPP ? 'Pedir reunión' : 'Confirmar reunión'}</button>
        </div>
      </section>

      <!-- 4. Confirmación -->
      <section class="paso-test" data-paso="confirmada" hidden>
        <p class="etiqueta">Paso 4 · Turno</p>
        <h2 tabindex="-1">{POR_WHATSAPP ? 'Último paso: mandanos tu pedido' : '¡Reunión confirmada!'}</h2>
        {
          POR_WHATSAPP && (
            <p class="bajada">
              Tocá «Enviar por WhatsApp»: el mensaje ya está escrito. Te respondemos para confirmar el turno y te mandamos la
              invitación con el link de {AGENDA.plataforma}.
            </p>
          )
        }
        <div class="confirmacion">
          <div class="turno-ficha">
            <div class="turno">
              <p class="etiqueta">{POR_WHATSAPP ? 'Tu pedido' : 'Tu reunión'}</p>
              <p class="turno-dia" id="turno-dia"></p>
              <p class="turno-hora" id="turno-hora"></p>
              <p class="turno-lugar"><Icono nombre="video" />Videollamada por {AGENDA.plataforma}</p>
              <ul class="turno-ambientes" id="turno-ambientes"></ul>
              <p class="turno-total" id="turno-total"></p>
              <p class="turno-desglose" id="turno-desglose"></p>
            </div>
            <div class="cota cota--v" aria-hidden="true"><span>{AGENDA.duracionMin} min</span></div>
            <div class="cota cota--h" aria-hidden="true"><span>Google Meet</span></div>
          </div>
          <div class="mensaje-wa">
            <div class="wa-cabeza">
              <Monograma class="wa-avatar" aria-hidden="true" />
              <div>
                <p class="wa-nombre">{ESTUDIO.nombre} · Diseño de interiores</p>
                <p class="wa-estado" id="wa-estado"></p>
              </div>
            </div>
            <p class:list={['wa-burbuja', POR_WHATSAPP && 'wa-burbuja--propia']} id="wa-mensaje"></p>
            <a class:list={['boton', !POR_WHATSAPP && 'boton--chico']} id="wa-confirmar" href="#" target="_blank" rel="noopener" hidden>
              <Icono nombre="mensaje" />{POR_WHATSAPP ? 'Enviar por WhatsApp' : 'Confirmá por WhatsApp'}
            </a>
          </div>
        </div>
        <p class="confirmacion-email" id="confirmacion-email"></p>
        <button class="enlace otro-turno" type="button" id="otro-turno">Agendar otra reunión</button>
        <div class="invitacion">
          <p>No es obligatorio, pero nos encantaría que hagas este test rápido para conocer tu estilo antes de la reunión.</p>
          <button class="boton boton--grande" type="button" data-siguiente="intro">¿Querés hacer un test para saber tu tipo de estilo?</button>
          <a class="enlace" href="/">Ahora no, volver al inicio</a>
        </div>
      </section>

      <!-- Intro del test -->
      <section class="paso-test intro" data-paso="intro" hidden>
        <p class="etiqueta">Test de estilo · 4 pasos</p>
        <h2 class="intro-titulo" tabindex="-1">Empezá:</h2>
        <div class="intro-cuerpo">
          <div class="definicion">
            <p class="etiqueta">¿Qué es un moodboard?</p>
            <p>Es una composición visual que reúne imágenes, colores, texturas y referencias para transmitir el estilo y la atmósfera de un proyecto antes de empezar a diseñarlo.</p>
          </div>
          <ol class="intro-pasos">
            <li><span>4</span> estilos</li>
            <li><span>4</span> colores</li>
            <li><span>4</span> sensaciones</li>
            <li><span>4</span> materiales</li>
          </ol>
        </div>
        <p class="intro-regalo">Al final te regalamos tu moodboard personalizado.</p>
        <div class="paso-pie">
          <span></span>
          <button class="boton boton--grande" type="button" data-siguiente="estilos">Comenzar test</button>
        </div>
      </section>

      <section class="paso-test" data-paso="estilos" hidden>
        <p class="etiqueta">Test · 1 de 4</p>
        <h2 tabindex="-1">Seleccioná 4 estilos</h2>
        <p class="bajada">Quedate con los que te den ganas de vivir ahí, aunque no sepas cómo se llaman.</p>
        <Grilla tipo="estilos" />
        <div class="paso-pie"><span class="seleccion" data-cuenta="estilos"></span><button class="boton" type="button" data-siguiente="colores" data-requiere="estilos">Siguiente</button></div>
      </section>

      <section class="paso-test" data-paso="colores" hidden>
        <p class="etiqueta">Test · 2 de 4</p>
        <h2 tabindex="-1">Seleccioná 4 colores principales</h2>
        <Grilla tipo="colores" />
        <div class="paso-pie"><span class="seleccion" data-cuenta="colores"></span><button class="boton" type="button" data-siguiente="sensaciones" data-requiere="colores">Siguiente</button></div>
      </section>

      <section class="paso-test" data-paso="sensaciones" hidden>
        <p class="etiqueta">Test · 3 de 4</p>
        <h2 tabindex="-1">Seleccioná 4 sensaciones</h2>
        <p class="bajada">¿Qué te gustaría que te transmita tu casa?</p>
        <Grilla tipo="sensaciones" />
        <div class="paso-pie"><span class="seleccion" data-cuenta="sensaciones"></span><button class="boton" type="button" data-siguiente="materiales" data-requiere="sensaciones">Siguiente</button></div>
      </section>

      <section class="paso-test" data-paso="materiales" hidden>
        <p class="etiqueta">Test · 4 de 4</p>
        <h2 tabindex="-1">Seleccioná 4 materiales</h2>
        <Grilla tipo="materiales" />
        <div class="paso-pie"><span class="seleccion" data-cuenta="materiales"></span><button class="boton" type="button" data-siguiente="carga" data-requiere="materiales">Ver mi moodboard</button></div>
      </section>

      <section class="paso-test carga" data-paso="carga" hidden>
        <h2 class="visualmente-oculto" tabindex="-1">Armando tu moodboard</h2>
        <IsotipoSvg class="carga-isotipo" aria-hidden="true" />
        <div class="carga-grilla" id="carga-grilla" aria-hidden="true"></div>
        <p class="carga-frase" id="carga-frase" aria-live="polite">Tu estilo habla por vos…</p>
        <p class="etiqueta">Estamos creando tu idea</p>
      </section>

      <section class="paso-test resultado" data-paso="resultado" hidden>
        <div class="resultado-cabeza">
          <p class="etiqueta">¡Test aprobado!</p>
          <h2 tabindex="-1">Tu estilo se basa en…</h2>
        </div>
        <div class="resultado-cuerpo">
          <figure class="resultado-tablero">
            <div class="collage" id="collage-resultado" role="group" aria-label="Tu moodboard"></div>
            <figcaption class="firma">@{ESTUDIO.instagram.toUpperCase()}</figcaption>
          </figure>
          <div class="resultado-lado">
            <div class="leyenda" id="leyenda"></div>
            <div class="resultado-acciones">
              <button class="boton" type="button" id="compartir-moodboard" hidden><Icono nombre="compartir" />Compartir</button>
              <button class="boton" type="button" id="guardar-moodboard"><Icono nombre="descargar" />Guardar moodboard</button>
              <button class="boton boton--linea" type="button" id="ver-imagen">Ver como imagen</button>
            </div>
            <p class="nota">Formato historia de Instagram, listo para compartir.</p>
            {
              !CON_BACKEND && moodboardPorWhatsapp && (
                <p class="nota">
                  ¿Querés que lo veamos antes de la reunión? Guardalo y mandánoslo por{' '}
                  <a href={moodboardPorWhatsapp} target="_blank" rel="noopener">WhatsApp</a>.
                </p>
              )
            }
            <button class="enlace" type="button" id="repetir-test">Hacer el test de nuevo</button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <dialog class="dialogo" id="dialogo-imagen" aria-labelledby="dialogo-titulo">
    <div class="dialogo-cabeza">
      <p class="etiqueta" id="dialogo-titulo">Tu moodboard</p>
      <button class="redondo" type="button" id="cerrar-dialogo" aria-label="Cerrar">×</button>
    </div>
    <img id="dialogo-img" alt="Moodboard personalizado en formato historia" />
    <p class="nota">En el celular, mantené presionada la imagen para guardarla. En la compu, clic derecho y «Guardar imagen».</p>
  </dialog>

  <script>
    import '../scripts/test/index';
  </script>
</Base>
