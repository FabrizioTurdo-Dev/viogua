---
// Footer azul a todo el ancho: navegación, reuniones, créditos.
import '../../styles/pie.css';
import Logo from '../marca/Logo.astro';
import Icono from '../marca/Icono.astro';
import { AGENDA, DESARROLLADOR, ESTUDIO, desarrolladorUrl } from '../../data/estudio';
import { MATERIALES } from '../../data/test';

const dev = import.meta.env.DEV;
const enInicio = Astro.url.pathname === '/';
const pre = enInicio ? '' : '/';
const anio = new Date().getFullYear();
---

<footer class="pie" aria-label="Pie de página">
  <div class="envoltura">
    <div class="pie-columnas">
      <div class="pie-marca">
        <a class="marca" href="/" aria-label={`${ESTUDIO.nombre}, ir al inicio`}>
          <span class="marca-logo"><Logo decorativo /></span>
        </a>
        <p>{ESTUDIO.identidad}</p>
      </div>

      <nav class="pie-col" aria-labelledby="pie-nav">
        <h3 id="pie-nav" class="etiqueta">Navegación</h3>
        <ul>
          <li><a class="subrayado" href={`${pre}#proceso`}>Cómo trabajamos</a></li>
          <li><a class="subrayado" href={`${pre}#moodboard`}>Test de estilo</a></li>
          <li><a class="subrayado" href={`${pre}#promos`}>Promos</a></li>
          <li><a class="subrayado" href={`${pre}#preguntas`}>Preguntas frecuentes</a></li>
          <li><a class="subrayado" href="/test/">Agendar reunión</a></li>
        </ul>
      </nav>

      <div class="pie-col">
        <h3 class="etiqueta">Reuniones</h3>
        <ul>
          <li class="pie-dato"><Icono nombre="video" />Videollamada por {AGENDA.plataforma}</li>
          <li class="pie-dato"><Icono nombre="reloj" /><span>{AGENDA.resumen}{dev && <span class="pendiente">ejemplo</span>}</span></li>
        </ul>
      </div>
    </div>

    <div class="pie-barra">
      <p>© {anio} {ESTUDIO.nombre} · {ESTUDIO.rubro}</p>
      <a class="subrayado" href="/privacidad/">Privacidad</a>
      <details class="pie-creditos">
        <summary>Créditos de fotos</summary>
        <p>
          Fotos de materiales en Unsplash:{' '}
          {MATERIALES.map((m, i) => (
            <>
              <a href={m.credito.url} rel="noopener" target="_blank">{m.nombre} ({m.credito.autor})</a>
              {i < MATERIALES.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </details>
      <a class="pie-arriba subrayado" href="#contenido">Volver arriba <Icono nombre="arriba" /></a>
    </div>

    <p class="pie-credito">
      <a href={desarrolladorUrl} rel="noopener" target="_blank">
        <Icono nombre="mensaje" />
        <span>Desarrollado por <span class="pie-credito-nombre">{DESARROLLADOR.nombre}</span></span>
      </a>
    </p>
  </div>
</footer>
