---
// Metadatos de cada página: título, descripción, canonical, Open Graph, Twitter y datos estructurados.
import { ESTUDIO } from '../../data/estudio';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica (por defecto, la de la página). */
  ruta?: string;
  imagen?: string;
  noindex?: boolean;
  datos?: Record<string, unknown>[];
}

const { titulo, descripcion, ruta = Astro.url.pathname, imagen = '/og.jpg', noindex = false, datos = [] } = Astro.props;
const canonical = new URL(ruta, Astro.site);
const imagenUrl = new URL(imagen, Astro.site);
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content={ESTUDIO.nombre} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagenUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${ESTUDIO.nombre} · ${ESTUDIO.lema}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenUrl} />

{datos.map(d => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
