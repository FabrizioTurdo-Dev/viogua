---
// Destello de 4 puntas (blanco por defecto). Se posiciona con la clase o el style que reciba.
interface Props {
  class?: string;
  style?: string;
}
const { class: clase, style } = Astro.props;
---

<span class:list={['destello', clase]} style={style} aria-hidden="true">
  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 0C12.6 6.4 17.6 11.4 24 12 17.6 12.6 12.6 17.6 12 24 11.4 17.6 6.4 12.6 0 12 6.4 11.4 11.4 6.4 12 0Z" /></svg>
</span>
